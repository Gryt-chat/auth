{
  "uid": "gryt-reach",
  "title": "Gryt Reach",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "tags": [
    "gryt"
  ],
  "panels": [
    {
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 99,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Online now",
      "description": "Open connections to the Gryt servers we run. One person with the app open on two devices counts twice.",
      "datasource": {
        "type": "prometheus"
      },
      "id": 100,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(gryt_socketio_connections_active)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Most online today",
      "description": "The highest number of open connections in the last 24 hours.",
