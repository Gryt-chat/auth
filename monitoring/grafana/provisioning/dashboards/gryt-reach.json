    {
      "type": "barchart",
      "title": "Desktop installs per version",
      "datasource": {
        "type": "prometheus"
      },
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (version, order) (gryt_release_installer_downloads_by_version{repo=\"gryt\"})",
          "legendFormat": "{{version}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80
          }
        }
      },
      "description": "Installer downloads for each minor version, its patch releases added together. Auto-updates count too.",
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "order",
                "destinationType": "number"
              },
              {
                "targetField": "version",
                "destinationType": "string"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "order"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "order": true
            }
          }
        }
      ],
      "options": {
        "orientation": "vertical",
        "xField": "version",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0
      }
    },
