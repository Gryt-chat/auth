# Per-machine settings for gryt-offsite-backup.service.
# Install to /etc/default/gryt-offsite-backup. The first three are required and
# the unit will not start without them.

# Where the dumps are read from. Defaults to the backups directory beside the
# compose file; on dev they are on a CIFS mount, so it has to be set.
GRYT_AUTH_BACKUP_DIR=/mnt/gryt-backups/keycloak

# The ssh destination. A dedicated account on the VPS whose key is pinned to
# ops/offsite_receive.sh, not a login that can run a shell.
GRYT_OFFSITE_HOST=gryt-backup@193.200.238.156

# The age recipient every dump is encrypted to. Either the public key itself or
# a path to a file of them. The private half belongs in a password manager and
# on neither machine.
GRYT_OFFSITE_RECIPIENT=age1...

# The ssh key for the account above. Its own key, used for nothing else, so it
# can be revoked without taking anything else with it.
GRYT_OFFSITE_SSH_KEY=/root/.ssh/id_ed25519_gryt_offsite

# Fail when the newest copy off-site is older than this. Dumps are taken every
# six hours and copied daily, so anything past a day means something stopped.
#GRYT_OFFSITE_STALE_HOURS=26

# Refuse to send an encrypted file smaller than this. A real dump is about
# 138 KB; an empty one is a few hundred bytes.
#GRYT_OFFSITE_MIN_BYTES=10000

# A Discord webhook posted to when a run fails. Without it the only sign is the
# unit sitting in `systemctl --failed`, which needs somebody to look.
#GRYT_OFFSITE_ALERT_WEBHOOK=https://discord.com/api/webhooks/...

# The ssh command. Only useful for testing against something that is not ssh.
#GRYT_OFFSITE_SSH=ssh
